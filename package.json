{
  "name": "mosaic",
  "version": "1.0.0",
  "description": "Declarative content blocks for your notes: charts, data tables, timelines, metric cards, decision records and flow diagrams from inline CSV, JSON or dataset files.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc && node esbuild.config.mjs production",
    "test": "node --test tests/**/*.test.mjs",
    "install:vault": "npm run build && cp main.js manifest.json styles.css ../mosaic-test-vault/.obsidian/plugins/mosaic/"
  },
  "keywords": [
    "obsidian-plugin",
    "charts",
    "data-table",
    "timeline",
    "flow-diagram",
    "metrics",
    "csv",
    "dataset",
    "content-blocks",
    "visualization"
  ],
  "author": "GilbertzzzzzzZZZ",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@types/react": "^17.0.36",
    "@types/react-dom": "^17.0.11",
    "@typescript-eslint/eslint-plugin": "^5.2.0",
    "@typescript-eslint/parser": "^5.2.0",
    "esbuild": ">=0.25.0",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ant-design/plots": "^1.0.9",
    "react": "npm:@preact/compat@^17.0.2",
    "react-dom": "npm:@preact/compat@^17.0.2"
  },
  "repository": "git@github.com:GilbertzzzZZ/mosaic.git"
}
