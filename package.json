{
  "name": "mosaic",
  "version": "1.0.0",
  "description": "Declarative content blocks for your notes: charts, data tables, timelines, metric cards, decision records and flow diagrams from inline CSV, JSON or dataset files.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc && node esbuild.config.mjs production",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "install:vault": "npm run build && cp main.js manifest.json styles.css \"$MOSAIC_PLUGIN_DIR\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "obsidian-plugin",
    "charts",
    "data-table",
    "timeline",
    "flow-diagram",
    "metrics",
    "csv",
    "dataset",
    "content-blocks",
    "visualization"
  ],
  "author": "GilbertzzzzzzZZZ",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": ">=0.25.0",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ant-design/plots": "^2.6.8",
    "@antv/scale": "^0.5.2",
    "react": "npm:@preact/compat@^17.0.2",
    "react-dom": "npm:@preact/compat@^17.0.2"
  },
  "repository": "git@github.com:GilbertzzzZZ/mosaic.git"
}
